{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/main/src/parser/StudyConfigSchema.json",
  
    "studyMetadata": {
      "title": "HAIC Mastermind — Cognitive Responsibility and AI Autonomy",
      "version": "v-2",
      "authors": ["Nils Ness"],
      "date": "2026-03-04",
      "description": "Between-subjects study: Human-only control vs high cognitive responsibility (AI as a Judge, low AI autonomy) vs low cognitive responsibility (AI as an Advisor, high AI autonomy) in Mastermind with increasing difficulty.",
      "organizations": ["Technical University of Munich"]
    },
  
    "uiConfig": {
      "contactEmail": "nils.ness@tum.de",
      "helpTextPath": "HAIC_study/assets/help.md",
      "logoPath": "HAIC_study/assets/logo.svg.png",
      "withProgressBar": true,
      "autoDownloadStudy": false,
      "withSidebar": true,
      "enumerateQuestions": true
    },

    "baseComponents": {
      "mind_human_only": {
        "type": "website",
        "response": [
          {
            "id": "mastermind_human_only_reactive",
            "prompt": "Play the Game!",
            "required": true,
            "location": "belowStimulus",
            "type": "reactive"
          }
        ],
        "path": "HAIC_study/assets/Human_only_increasing_complexity.html",
        "instructionLocation": "aboveStimulus"
      },
      "mind_judge": {
        "type": "website",
        "response": [
          {
            "id": "mastermind_judge_reactive",
            "prompt": "Play the Game!",
            "required": true,
            "location": "belowStimulus",
            "type": "reactive"
          }
        ],
        "path": "HAIC_study/assets/HAIC_role_Judge_increasing complexity.html",
        "instructionLocation": "aboveStimulus"
      },
      "mind_advisor": {
        "type": "website",
        "response": [
          {
            "id": "mastermind_advisor_reactive",
            "prompt": "Play the Game!",
            "required": true,
            "location": "belowStimulus",
            "type": "reactive"
          }
        ],
        "path": "HAIC_study/assets/HAIC_role_Advisor_increasing_complexity.html",
        "instructionLocation": "aboveStimulus"
      }
    },

    "components": {
      "introduction": {
        "type": "markdown",
        "path": "HAIC_study/assets/introduction.md",
        "response": []
      },

      "mastermind_human_only": {
        "baseComponent": "mind_human_only",
        "description": "Play Mastermind on your own with increasing difficulty (1→6 colors).",
        "response": [
          {
            "id": "played-game",
            "prompt": "What was the password?",
            "required": true,
            "type": "shortText"
          }
        ]
      },

      "mastermind_judge": {
        "baseComponent": "mind_judge",
        "description": "High cognitive responsibility (AI as a Judge): you create and submit guesses; the AI has low autonomy and only reviews a guess when you explicitly send it.",
        "response": [
          {
            "id": "played-game",
            "prompt": "What was the password?",
            "required": true,
            "type": "shortText"
          }
        ]
      },

      "mastermind_advisor": {
        "baseComponent": "mind_advisor",
        "description": "Low cognitive responsibility (AI as an Advisor): the AI has high autonomy and proactively proposes the next guess using a trained Mastermind RL model; you can apply or adjust it before submitting.",
        "response": [
          {
            "id": "played-game",
            "prompt": "What was the password?",
            "required": true,
            "type": "shortText"
          }
        ]
      },

