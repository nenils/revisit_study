# Copy this file to .env on the LRZ VM and fill in the values.

# Public URL of your deployed study, used by the API for CORS and optional OpenRouter headers.
STUDY_PUBLIC_URL=https://your-lrz-vm.example

# Put your LLM token here. Do not put it into HTML files.
# The proxy in services/haic_api forwards LLM requests to OpenRouter server-side.
OPENROUTER_API_KEY=

# Optional: change the LLM model.
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
