# Copy this file to .env.docker on the LRZ VM and fill in the values.

# Public URL of your deployed study, used by the API for CORS and optional OpenRouter headers.
STUDY_PUBLIC_URL=https://your-lrz-vm.example

# Put your LLM token here. Do not put it into HTML files.
# The proxy in services/haic_api forwards LLM requests to OpenRouter server-side.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional: change the LLM model.
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# Optional: trained Mastermind RL artifact inside the haic-api container.
# Put the file in services/haic_api/models/ before building and point to it here.
# If unset or invalid, the API uses the bundled dummy consistency-filter model.
# RL_MODEL_PATH=/app/models/mastermind_rl_model.pt
